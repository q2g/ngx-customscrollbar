{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "ngx-customscrollbars-examples": {
            "root": "",
            "sourceRoot": "examples",
            "projectType": "application",
            "prefix": "ngx-custom-scrollbar",
            "schematics": { },
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": {
                            "base": "dist/ngx-customscrollbars-examples"
                        },
                        "index": "examples/index.html",
                        "polyfills": [
                            "examples/polyfills.ts"
                        ],
                        "tsConfig": "examples/tsconfig.app.json",
                        "assets": [
                            "examples/src/favicon.ico",
                            "examples/src/assets"
                        ],
                        "styles": [
                            "examples/styles.scss"
                        ],
                        "scripts": [ ],
                        "extractLicenses": false,
                        "sourceMap": true,
                        "optimization": false,
                        "namedChunks": true,
                        "browser": "examples/main.ts"
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "examples/environments/environment.ts",
                                    "with": "examples/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true
                        }
                    },
                    "defaultConfiguration": ""
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "options": {
                        "buildTarget": "ngx-customscrollbars-examples:build"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "ngx-customscrollbars-examples:build:production"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "buildTarget": "ngx-customscrollbars-examples:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "examples/test.ts",
                        "polyfills": "examples/polyfills.ts",
                        "tsConfig": "examples/tsconfig.spec.json",
                        "karmaConfig": "examples/karma.conf.js",
                        "styles": [
                            "examples/styles.scss"
                        ],
                        "scripts": [ ],
                        "assets": [
                            "examples/favicon.ico",
                            "examples/assets"
                        ]
                    }
                }
            }
        },
        "ngx-customscrollbars": {
            "root": "",
            "sourceRoot": "lib",
            "projectType": "library",
            "prefix": "ngx-customscrollbar",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "tsConfig": "lib/tsconfig.lib.json",
                        "project": "lib/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "tsconfig.lib.prod.json"
                        }
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "lib/test.ts",
                        "tsConfig": "lib/tsconfig.spec.json",
                        "karmaConfig": "lib/karma.conf.js"
                    }
                }
            }
        }
    },
    "cli": {
      "analytics": false
    }
}
